# --- Pi-hole v6 (read-only) ---------------------------------------------
# Web interface address, with or without /admin
PIHOLE_URL=http://192.168.1.2
# Use an *app password* (Settings → Web interface / API → Configure app password).
# App passwords skip 2FA and never reach the browser.
PIHOLE_PASSWORD=

# --- Proxmox VE (read-only API token) -------------------------------------
PROXMOX_URL=https://192.168.1.10:8006
PROXMOX_TOKEN_ID=precog@pve!dashboard
PROXMOX_TOKEN_SECRET=
# Proxmox ships a self-signed certificate. Point to its CA (/etc/pve/pve-root-ca.pem) …
# PROXMOX_CA_FILE=/certs/pve-root-ca.pem
# … or, on a network you trust, skip verification:
# PROXMOX_INSECURE_TLS=true

# --- Dashboard ------------------------------------------------------------
# Strongly recommended: the dashboard shows every device and DNS lookup on your network.
PRECOG_PASSWORD=
# PRECOG_USER=precog
# PORT=8080
# POLL_SECONDS=15
# DEMO=1   # fake homelab, no credentials needed
